@* Modules of one semester. Grades are edited inline (saved when the field loses focus / Enter);
   in ReadOnly mode (administrator inspection) every control is replaced by plain text. *@

<div class="table-wrap">
    <table class="table modules-table">
        <thead>
            <tr>
                <th scope="col">Module</th>
                <th scope="col" class="num">Coef.</th>
                <th scope="col" class="grade-col">CC1</th>
                <th scope="col" class="grade-col">CC2</th>
                <th scope="col" class="grade-col">Lab</th>
                <th scope="col" class="grade-col">Exam</th>
                <th scope="col" class="num">Final grade</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Modules)
            {
                var m = v.Module;
                var open = _expanded.Contains(m.Id);
                <tr class="mod-row @(open ? "is-open" : "")" @key="@($"{m.Id}:{Revision}")">
                    <td data-label="Module" class="mod-name">
                        <button type="button" class="expander" aria-expanded="@open.ToString().ToLowerInvariant()"
                                aria-label="@(open ? "Hide" : "Show") details for @m.Name" @onclick="() => Toggle(m.Id)">
                            <Icon Name="chevron" Size="16" />
                        </button>
                        <div class="mod-title">
                            <strong>@m.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(m.Code)) { <span class="muted small">@m.Code</span> }
                        </div>
                    </td>
                    <td data-label="Coef." class="num">@GradeFormat.Number(m.Coefficient)</td>
                    <td data-label="CC1" class="grade-col"><GradeCell Value="m.Cc1" Max="m.MaxGrade" ReadOnly="ReadOnly" Label="@($"CC1 grade for {m.Name}")" OnChanged="g => Edit(v, Field.Cc1, g)" OnInvalid="OnInvalidInput" /></td>
                    <td data-label="CC2" class="grade-col"><GradeCell Value="m.Cc2" Max="m.MaxGrade" ReadOnly="ReadOnly" Label="@($"CC2 grade for {m.Name}")" OnChanged="g => Edit(v, Field.Cc2, g)" OnInvalid="OnInvalidInput" /></td>
                    <td data-label="Lab" class="grade-col">
                        @if (m.HasLabExam) { <GradeCell Value="m.LabGrade" Max="m.MaxGrade" ReadOnly="ReadOnly" Label="@($"Lab grade for {m.Name}")" OnChanged="g => Edit(v, Field.Lab, g)" OnInvalid="OnInvalidInput" /> }
                        else { <span class="muted" title="This module has no lab exam">—</span> }
                    </td>
                    <td data-label="Exam" class="grade-col"><GradeCell Value="m.ExamGrade" Max="m.MaxGrade" ReadOnly="ReadOnly" Label="@($"Exam grade for {m.Name}")" OnChanged="g => Edit(v, Field.Exam, g)" OnInvalid="OnInvalidInput" /></td>
                    <td data-label="Final grade" class="num">
                        @if (v.Result.Grade is { } g)
                        {
                            <span class="final-wrap">
                                <strong class="final @(v.Result.Passed == true ? "final-pass" : "final-fail")">@GradeFormat.Fixed2(g)</strong>
                                <span class="muted small">/ @GradeFormat.Number(m.MaxGrade)</span>
                            </span>
                        }
                        else { <span class="muted">—</span> }
                    </td>
                    <td data-label="Status"><StatusBadge Result="v.Result" /></td>
                </tr>
                @if (open)
                {
                    <tr class="detail-row" @key="@($"{m.Id}:detail")">
                        <td colspan="8">
                            <div class="detail">
                                <dl class="facts">
                                    <div><dt>Formula used</dt>
                                        <dd>
                                            @if (!ReadOnly)
                                            {
                                                <select class="input input-sm" aria-label="Formula for @m.Name" @onchange="e => ChangeFormula(m.Id, e)">
                                                    @if (v.Formula is null) { <option value="" selected>— none selected —</option> }
                                                    @foreach (var f in Formulas.Where(f => f.ForLabExam == m.HasLabExam))
                                                    {
                                                        <option value="@f.Id" selected="@(f.Id == m.FormulaId)">@f.Name</option>
                                                    }
                                                </select>
                                            }
                                            else { @(v.Formula?.Name ?? "— none —") }
                                        </dd>
                                    </div>
                                    <div><dt>Expression</dt><dd>@if (v.Formula is not null) { <code>@v.Formula.Expression</code> } else { <span class="muted">—</span> }</dd></div>
                                    <div><dt>Calculated grade</dt><dd>@(v.Result.Grade is { } cg ? $"{GradeFormat.Fixed2(cg)} / {GradeFormat.Number(m.MaxGrade)}" : "—")</dd></div>
                                    <div><dt>Passing threshold</dt><dd>@GradeFormat.Number(m.PassingThreshold) / @GradeFormat.Number(m.MaxGrade)</dd></div>
                                    <div><dt>Coefficient</dt><dd>@GradeFormat.Number(m.Coefficient)</dd></div>
                                    <div><dt>Calculation status</dt><dd>@v.Result.StatusText</dd></div>
                                </dl>

                                @if (v.Result.RequiredExam.Kind != RequiredExamKind.NotApplicable)
                                {
                                    <div class="callout callout-@RequiredTone(v.Result.RequiredExam.Kind)" role="note">
                                        <strong>Required exam grade.</strong> @v.Result.RequiredExam.Message
                                    </div>
                                }
                                @if (v.Result.Status is ModuleStatus.FormulaError or ModuleStatus.NoFormula)
                                {
                                    <div class="callout callout-danger" role="alert">
                                        @(v.Result.Status == ModuleStatus.NoFormula
                                            ? (m.HasLabExam
                                                ? "No lab formula is selected for this module. Create or pick one in Formula Settings."
                                                : "No formula is selected for this module.")
                                            : v.Result.FormulaError)
                                    </div>
                                }
                                @if (v.Result.Status == ModuleStatus.Incomplete && v.Result.MissingInputs.Count > 0)
                                {
                                    <div class="callout callout-warn">Missing: @string.Join(", ", v.Result.MissingInputs). No final grade is shown until these are entered.</div>
                                }

                                @if (!ReadOnly)
                                {
                                    <div class="detail-actions">
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => OnEdit.InvokeAsync(m)"><Icon Name="edit" Size="15" />Edit module</button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@(IsFirst(v))" @onclick="() => OnMove.InvokeAsync((m.Id, -1))"><Icon Name="up" Size="15" />Move up</button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@(IsLast(v))" @onclick="() => OnMove.InvokeAsync((m.Id, 1))"><Icon Name="down" Size="15" />Move down</button>
                                        <button type="button" class="btn btn-ghost btn-sm text-danger" @onclick="() => OnDelete.InvokeAsync(m)"><Icon Name="trash" Size="15" />Delete</button>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private enum Field { Cc1, Cc2, Lab, Exam }

    private readonly HashSet<Guid> _expanded = [];

    [Parameter, EditorRequired] public IReadOnlyList<ModuleView> Modules { get; set; } = [];
    [Parameter] public IReadOnlyList<GradeFormula> Formulas { get; set; } = [];
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Bumped by the parent after a rejected edit so inputs are re-created with the stored values.</summary>
    [Parameter] public int Revision { get; set; }

    [Parameter] public EventCallback<(Guid ModuleId, GradesForm Grades)> OnGrades { get; set; }
    [Parameter] public EventCallback<(Guid ModuleId, Guid? FormulaId)> OnFormula { get; set; }
    [Parameter] public EventCallback<Module> OnEdit { get; set; }
    [Parameter] public EventCallback<Module> OnDelete { get; set; }
    [Parameter] public EventCallback<(Guid ModuleId, int Direction)> OnMove { get; set; }
    [Parameter] public EventCallback<string> OnInvalidInput { get; set; }

    private void Toggle(Guid id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private bool IsFirst(ModuleView v) => Modules.Count > 0 && Modules[0].Module.Id == v.Module.Id;
    private bool IsLast(ModuleView v) => Modules.Count > 0 && Modules[^1].Module.Id == v.Module.Id;

    private static string RequiredTone(RequiredExamKind kind) => kind switch
    {
        RequiredExamKind.Needed => "info",
        RequiredExamKind.AlreadySecured => "success",
        RequiredExamKind.Impossible => "danger",
        _ => "warn",
    };

    private Task Edit(ModuleView v, Field field, double? parsed)
    {
        var m = v.Module;
        var grades = new GradesForm(
            field == Field.Cc1 ? parsed : m.Cc1,
            field == Field.Cc2 ? parsed : m.Cc2,
            field == Field.Lab ? parsed : m.LabGrade,
            field == Field.Exam ? parsed : m.ExamGrade);
        return OnGrades.InvokeAsync((m.Id, grades));
    }

    private Task ChangeFormula(Guid moduleId, ChangeEventArgs e) =>
        OnFormula.InvokeAsync((moduleId, Guid.TryParse(e.Value?.ToString(), out var id) ? id : null));
}
