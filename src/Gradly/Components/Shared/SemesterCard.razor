<article class="card sem-card">
    <div class="sem-card-head">
        <div class="sem-card-id">
            <h3 class="sem-card-title"><a href="@Href">@View.Semester.Name</a></h3>
            <div class="muted small">@Subtitle</div>
        </div>
        <div class="avg" title="Semester average">
            <span class="avg-value">@UiFormat.Average(View.Summary)</span>
            @if (View.Summary.Average is not null)
            {
                <span class="avg-scale">/ @GradeFormat.Number(View.Summary.Scale)</span>
            }
        </div>
    </div>
    @if (View.Summary.ModuleCount == 0)
    {
        <div class="split muted small">No modules yet</div>
    }
    else
    {
        <StatusSplit Summary="View.Summary" Compact="true" />
    }
    @Actions
</article>

@code {
    [Parameter, EditorRequired] public SemesterView View { get; set; } = default!;
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }

    private string Subtitle
    {
        get
        {
            var parts = new List<string> { UiFormat.Plural(View.Summary.ModuleCount, "module") };
            if (!string.IsNullOrWhiteSpace(View.Semester.AcademicYear)) parts.Add(View.Semester.AcademicYear!);
            if (View.Semester.StartDate is { } s && View.Semester.EndDate is { } e) parts.Add($"{UiFormat.Date(s)} – {UiFormat.Date(e)}");
            else if (View.Semester.StartDate is { } s2) parts.Add($"from {UiFormat.Date(s2)}");
            else if (View.Semester.EndDate is { } e2) parts.Add($"until {UiFormat.Date(e2)}");
            if (View.Summary.IsProvisional && View.Summary.Average is not null) parts.Add("provisional");
            return string.Join(" · ", parts);
        }
    }
}
