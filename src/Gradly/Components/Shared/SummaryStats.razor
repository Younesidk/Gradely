<div class="stat-grid">
    <div class="stat stat-primary">
        <div class="stat-label">@AverageLabel</div>
        <div class="stat-value">@UiFormat.Average(Summary)@if (Summary.Average is not null)
            {
                <span class="stat-unit"> / @GradeFormat.Number(Summary.Scale)</span>
            }
        </div>
        @if (Summary.Average is null)
        {
            <div class="stat-note">@(Summary.ModuleCount == 0 ? "No modules yet" : "Waiting for completed modules")</div>
        }
        else if (Summary.IsProvisional)
        {
            <div class="stat-note"><span class="tag tag-warn">Provisional</span> @Summary.IncompleteCount incomplete module@(Summary.IncompleteCount == 1 ? "" : "s") not counted</div>
        }
        else
        {
            <div class="stat-note">Weighted by coefficient</div>
        }
    </div>
    <div class="stat"><div class="stat-label">Modules</div><div class="stat-value">@Summary.ModuleCount</div></div>
    <div class="stat"><div class="stat-label">Completed</div><div class="stat-value">@Summary.CompletedCount</div></div>
    <div class="stat stat-warn"><div class="stat-label">Incomplete</div><div class="stat-value">@Summary.IncompleteCount</div></div>
    <div class="stat stat-success"><div class="stat-label">Passed</div><div class="stat-value">@Summary.PassedCount</div></div>
    <div class="stat stat-danger"><div class="stat-label">Failed</div><div class="stat-value">@Summary.FailedCount</div></div>
</div>

@code {
    [Parameter, EditorRequired] public SemesterSummary Summary { get; set; } = SemesterSummary.Empty;
    [Parameter] public string AverageLabel { get; set; } = "Semester average";
}
