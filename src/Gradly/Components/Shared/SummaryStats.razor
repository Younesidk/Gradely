<section class="summary" aria-label="@AverageLabel">
    <div class="summary-avg">
        <div class="summary-label">@AverageLabel</div>
        <div class="summary-value">
            <span class="summary-figure">@UiFormat.Average(Summary)</span>
            @if (Summary.Average is not null)
            {
                <span class="summary-scale">/ @GradeFormat.Number(Summary.Scale)</span>
            }
        </div>
        @if (Summary.Average is null)
        {
            <div class="summary-note">@(Summary.ModuleCount == 0 ? "No modules yet" : "Waiting for completed modules")</div>
        }
        else if (Summary.IsProvisional)
        {
            <div class="summary-note"><span class="tag tag-warn">Provisional</span> @UiFormat.Plural(Summary.IncompleteCount, "incomplete module") not counted</div>
        }
        else
        {
            <div class="summary-note">Weighted by coefficient</div>
        }
    </div>
    <StatusSplit Summary="Summary" />
</section>

@code {
    [Parameter, EditorRequired] public SemesterSummary Summary { get; set; } = SemesterSummary.Empty;
    [Parameter] public string AverageLabel { get; set; } = "Semester average";
}
