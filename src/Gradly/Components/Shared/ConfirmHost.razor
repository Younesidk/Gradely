@implements IDisposable
@inject ConfirmService Confirm

@if (_request is not null)
{
    <div class="modal-backdrop" @onclick="() => Close(false)">
        <div class="modal modal-sm" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" @onclick:stopPropagation="true">
            <h2 id="confirm-title" class="modal-title">@_request.Title</h2>
            <p class="muted">@_request.Message</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" @onclick="() => Close(false)">Cancel</button>
                <button type="button" class="btn @(_request.Danger ? "btn-danger" : "btn-primary")" @onclick="() => Close(true)">@_request.ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    private ConfirmRequest? _request;

    protected override void OnInitialized() => Confirm.OnRequest += Show;

    private void Show(ConfirmRequest request)
    {
        _ = InvokeAsync(() =>
        {
            _request?.Result.TrySetResult(false);
            _request = request;
            StateHasChanged();
        });
    }

    private void Close(bool result)
    {
        _request?.Result.TrySetResult(result);
        _request = null;
    }

    public void Dispose()
    {
        Confirm.OnRequest -= Show;
        _request?.Result.TrySetResult(false);
    }
}
