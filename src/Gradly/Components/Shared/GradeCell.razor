@if (ReadOnly)
{
    <span>@(Value is null ? "—" : GradeFormat.Number(Value))</span>
}
else
{
    <input class="grade-input" type="number" inputmode="decimal" step="any" min="0" max="@UiFormat.Input(Max)"
           value="@UiFormat.Input(Value)" placeholder="—" aria-label="@Label"
           @onchange="Changed" />
}

@code {
    [Parameter] public double? Value { get; set; }
    [Parameter] public double Max { get; set; } = 20;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Raised with the new value (null when the field was cleared).</summary>
    [Parameter] public EventCallback<double?> OnChanged { get; set; }
    [Parameter] public EventCallback<string> OnInvalid { get; set; }

    private async Task Changed(ChangeEventArgs e)
    {
        if (!UiFormat.TryParseGrade(e.Value?.ToString(), out var parsed))
        {
            await OnInvalid.InvokeAsync("That doesn't look like a number.");
            return;
        }
        await OnChanged.InvokeAsync(parsed);
    }
}
