@* Module states of a semester as one split bar: passed, failed, incomplete, and modules without a usable formula. *@
@if (Summary.ModuleCount > 0)
{
    <div class="split @(Compact ? "split-compact" : "")">
        <div class="split-bar" role="img" aria-label="@($"{Summary.PassedCount} passed, {Summary.FailedCount} failed, {Summary.IncompleteCount} incomplete of {Summary.ModuleCount} modules")">
            @Segment("passed", Summary.PassedCount)
            @Segment("failed", Summary.FailedCount)
            @Segment("incomplete", Summary.IncompleteCount)
            @Segment("other", Other)
        </div>
        <ul class="split-legend">
            <li><span class="dot dot-passed"></span><span class="count">@Summary.PassedCount</span> passed</li>
            <li><span class="dot dot-failed"></span><span class="count">@Summary.FailedCount</span> failed</li>
            <li><span class="dot dot-incomplete"></span><span class="count">@Summary.IncompleteCount</span> incomplete</li>
            @if (!Compact)
            {
                <li class="total">@Summary.CompletedCount of @UiFormat.Plural(Summary.ModuleCount, "module") completed</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired] public SemesterSummary Summary { get; set; } = SemesterSummary.Empty;
    [Parameter] public bool Compact { get; set; }

    private int Other => Math.Max(0, Summary.ModuleCount - Summary.PassedCount - Summary.FailedCount - Summary.IncompleteCount);

    private static RenderFragment Segment(string kind, int count) => __builder =>
    {
        if (count > 0)
        {
            <span class="split-seg seg-@kind" style="flex: @count"></span>
        }
    };
}
