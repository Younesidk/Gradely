@page "/account/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject RegistrationService Registration
@inject SignInManager<ApplicationUser> SignIn
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Nav

<PageTitle>Create your account · Gradly</PageTitle>

@if (_invitedEmail is null)
{
    <h1 class="auth-title">Invitation not valid</h1>
    <div class="alert alert-danger" role="alert">@RegistrationService.InvalidInvitation</div>
    <p class="muted">Ask your administrator to send you a new invitation.</p>
    <a class="btn btn-ghost btn-block" href="/account/login">Go to sign in</a>
}
else
{
    <h1 class="auth-title">Create your account</h1>
    <p class="muted auth-sub">You've been invited to Gradly. Choose a username and a password.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterAsync" FormName="register" class="form">
        <DataAnnotationsValidator />
        <div class="field">
            <label for="email">Email</label>
            <input id="email" class="input" value="@_invitedEmail" readonly aria-readonly="true" />
            <span class="hint">This is the address your invitation was sent to.</span>
        </div>
        <div class="field">
            <label for="username">Username</label>
            <InputText id="username" class="input" @bind-Value="Input.UserName" autocomplete="username" />
            <ValidationMessage For="() => Input.UserName" class="field-error" />
        </div>
        <div class="field">
            <label for="password">Password</label>
            <InputText id="password" type="password" class="input" @bind-Value="Input.Password" autocomplete="new-password" />
            <span class="hint">At least 10 characters, including a digit and a lowercase letter.</span>
            <ValidationMessage For="() => Input.Password" class="field-error" />
        </div>
        <div class="field">
            <label for="confirm">Confirm password</label>
            <InputText id="confirm" type="password" class="input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="field-error" />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create account</button>
    </EditForm>
}

@code {
    private string? _invitedEmail;
    private string? _error;

    [SupplyParameterFromQuery] private string? Token { get; set; }
    [SupplyParameterFromForm] private RegisterModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _invitedEmail = await Registration.GetInvitedEmailAsync(Token);
    }

    private async Task RegisterAsync()
    {
        var result = await Registration.RegisterAsync(Token, Input.UserName, Input.Password);
        if (!result.Success)
        {
            _error = result.Error;
            return;
        }
        var user = await Users.FindByIdAsync(result.UserId!);
        if (user is not null) await SignIn.SignInAsync(user, isPersistent: false);
        Nav.NavigateTo("/");
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Choose a username."), StringLength(40, MinimumLength = 3, ErrorMessage = "Usernames are 3 to 40 characters.")]
        public string? UserName { get; set; }

        [Required(ErrorMessage = "Choose a password.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Repeat your password."), Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string? ConfirmPassword { get; set; }
    }
}
