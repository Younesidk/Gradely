@page "/formulas"
@using System.Globalization
@using Gradly.Domain.Formulas
@inject FormulaService FormulaSvc
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS

<PageTitle>Formula settings · Gradly</PageTitle>

<div class="page-head">
    <div>
        <h1>Formula settings</h1>
        <p class="muted">How a module grade is computed from CC1, CC2, lab and exam</p>
    </div>
    <div class="page-actions">
        @if (_form is null)
        {
            <button type="button" class="btn btn-primary" @onclick="() => StartNew(false)"><Icon Name="plus" Size="16" />New formula</button>
        }
    </div>
</div>

@if (_formulas is null)
{
    <Loading />
}
else
{
    @if (_platformLab is not null && !_formulas.Any(f => f.Formula.ForLabExam) && _form is null)
    {
        <div class="callout callout-info">
            <strong>A lab formula is available.</strong> Your administrator has configured a default for modules with a lab exam.
            <button type="button" class="btn btn-ghost btn-sm" @onclick="AddPlatformLab">Add it to my formulas</button>
        </div>
    }

    @if (_form is not null)
    {
        <section class="card editor" aria-label="Formula editor">
            <h2>@(_editingId is null ? "New formula" : "Edit formula")</h2>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" class="form">
                <DataAnnotationsValidator />
                <div class="field-row field-row-wide">
                    <div class="field">
                        <label for="f-name">Name</label>
                        <InputText id="f-name" class="input" @bind-Value="_form.Name" maxlength="80" placeholder="e.g. Heavy exam weighting" />
                        <ValidationMessage For="() => _form.Name" class="field-error" />
                    </div>
                    <fieldset class="field fieldset">
                        <legend>Applies to</legend>
                        <label class="radio"><input type="radio" name="kind" checked="@(!_form.ForLabExam)" @onchange="() => SetKind(false)" disabled="@_kindLocked" /> Modules without lab exam</label>
                        <label class="radio"><input type="radio" name="kind" checked="@_form.ForLabExam" @onchange="() => SetKind(true)" disabled="@_kindLocked" /> Modules with lab exam</label>
                        @if (_kindLocked) { <span class="hint">Used by modules, so the type can't change.</span> }
                    </fieldset>
                </div>

                <div class="field">
                    <label for="expr">Expression</label>
                    <textarea id="expr" class="input mono" rows="3" spellcheck="false" autocomplete="off" maxlength="@Formula.MaxLength"
                              @bind="_form.Expression" @bind:event="oninput" @bind:after="Reparse"
                              aria-describedby="expr-status"></textarea>

                    <div class="palette" role="group" aria-label="Formula palette">
                        <div class="palette-group" role="group" aria-label="Variables">
                            <span class="palette-label">Variables</span>
                            @foreach (var v in FormulaVariables.For(_form.ForLabExam))
                            {
                                <button type="button" class="chip-btn" @onclick="() => Insert(v)">@v</button>
                            }
                        </div>
                        <div class="palette-group" role="group" aria-label="Operators">
                            <span class="palette-label">Operators</span>
                            @foreach (var (shown, text) in Operators)
                            {
                                <button type="button" class="chip-btn chip-btn-op" aria-label="Insert @text" @onclick="() => Insert(text)">@shown</button>
                            }
                        </div>
                        <div class="palette-group" role="group" aria-label="Functions">
                            <span class="palette-label">Functions</span>
                            @foreach (var fn in FormulaFunctions.All)
                            {
                                <button type="button" class="chip-btn" title="@fn.Description" @onclick='() => Insert(fn.Name + "(")'>@(fn.Name + "()")</button>
                            }
                        </div>
                    </div>

                    <div id="expr-status" aria-live="polite">
                        @if (_parse is { Success: true })
                        {
                            <div class="validation ok">✓ Valid formula</div>
                        }
                        else if (_parse is not null)
                        {
                            <div class="validation bad" role="alert">
                                ✕ @_parse.FirstError
                                @if (_parse.Errors[0].Position >= 0 && _form.Expression.Length > 0)
                                {
                                    <pre class="caret-pre">@_form.Expression<br />@(new string(' ', Math.Min(_parse.Errors[0].Position, _form.Expression.Length)))^</pre>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="preview">
                    <h3>Live example</h3>
                    <p class="muted small">Try some grades (out of 20, pass mark 10) to see what this formula gives.</p>
                    <div class="field-row field-row-4">
                        <div class="field"><label for="s-cc1">CC1</label><input id="s-cc1" class="input input-sm" type="number" step="any" @bind="_sCc1" @bind:event="oninput" /></div>
                        <div class="field"><label for="s-cc2">CC2</label><input id="s-cc2" class="input input-sm" type="number" step="any" @bind="_sCc2" @bind:event="oninput" /></div>
                        @if (_form.ForLabExam)
                        {
                            <div class="field"><label for="s-lab">Lab</label><input id="s-lab" class="input input-sm" type="number" step="any" @bind="_sLab" @bind:event="oninput" /></div>
                        }
                        <div class="field"><label for="s-exam">Exam</label><input id="s-exam" class="input input-sm" type="number" step="any" @bind="_sExam" @bind:event="oninput" /></div>
                    </div>
                    @if (_parse is { Success: true })
                    {
                        <div class="preview-result">
                            @if (PreviewFull is { } full)
                            {
                                @if (full.Grade is { } g)
                                {
                                    <div class="preview-grade">
                                        <span class="preview-label">Module grade</span>
                                        <strong class="@(full.Passed == true ? "final-pass" : "final-fail")">@GradeFormat.Fixed2(g)</strong>
                                        <span class="muted">/ 20</span>
                                        <StatusBadge Result="full" />
                                    </div>
                                }
                                else
                                {
                                    <div class="preview-grade"><span class="preview-label">Module grade</span> <span class="muted">@(full.FormulaError ?? full.StatusText)</span></div>
                                }
                            }
                            @if (PreviewRequired is { } req && req.RequiredExam.Kind != RequiredExamKind.NotApplicable)
                            {
                                <div class="preview-required muted small"><span class="preview-label">Before the exam</span> @req.RequiredExam.Message</div>
                            }
                        </div>
                    }
                </div>

                <label class="check">
                    <InputCheckbox @bind-Value="_form.IsDefault" />
                    <span>Use as my default for new modules @(_form.ForLabExam ? "with" : "without") a lab exam</span>
                </label>

                <div class="modal-actions inline-actions">
                    <button type="button" class="btn btn-ghost" @onclick="Cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@(_parse is not { Success: true } || _busy)">@(_editingId is null ? "Create formula" : "Save changes")</button>
                </div>
            </EditForm>
        </section>
    }

    @if (_formulas.Count == 0)
    {
        <EmptyState Icon="formula" Title="No formulas yet" Text="Create a formula to compute module grades.">
            <button type="button" class="btn btn-primary" @onclick="() => StartNew(false)"><Icon Name="plus" Size="16" />New formula</button>
        </EmptyState>
    }

    @foreach (var group in new[] { (Title: "Modules without a lab exam", Lab: false), (Title: "Modules with a lab exam", Lab: true) })
    {
        var items = _formulas.Where(f => f.Formula.ForLabExam == group.Lab).ToList();
        <div class="section-title"><h2>@group.Title</h2></div>
        @if (items.Count == 0)
        {
            <p class="muted small group-empty">
                No formula yet.
                @if (group.Lab) { <span>Modules with a lab exam stay incomplete until you add one.</span> }
                <button type="button" class="link-btn" @onclick="() => StartNew(group.Lab)">Create one</button>
            </p>
        }
        else
        {
            <div class="formula-list">
                @foreach (var fv in items)
                {
                    var f = fv.Formula;
                    <article class="card formula-card" @key="f.Id">
                        <div class="formula-head">
                            <h3>@f.Name</h3>
                            @if (f.IsDefault) { <span class="tag tag-primary">Default</span> }
                        </div>
                        <code class="formula-expr">@f.Expression</code>
                        <div class="muted small">Used by @fv.ModulesUsing module@(fv.ModulesUsing == 1 ? "" : "s")</div>
                        <div class="card-actions">
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEdit(fv)"><Icon Name="edit" Size="15" />Edit</button>
                            @if (!f.IsDefault)
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => MakeDefault(f)">Make default</button>
                            }
                            <button type="button" class="btn btn-ghost btn-sm text-danger" @onclick="() => Delete(fv)"><Icon Name="trash" Size="15" />Delete</button>
                        </div>
                    </article>
                }
            </div>
        }
    }

    <section class="card help">
        <h2>Formula syntax</h2>
        <ul class="plain-list">
            <li>Variables: <code>CC1</code>, <code>CC2</code>, <code>Lab</code> (lab formulas only), <code>Exam</code>.</li>
            <li>Operators: <code>+ - * /</code> and parentheses. Decimals use a dot: <code>0.4</code>.</li>
            <li>Functions: <code>AVG()</code>, <code>MIN()</code>, <code>MAX()</code>, <code>ABS()</code>, <code>ROUND(x, digits)</code>.</li>
            <li>Gradly only calculates “the exam grade you need” when the formula is a simple, increasing function of <code>Exam</code> (sums, weights, averages).
                Formulas like <code>MAX(Exam, …)</code> still compute a grade but won't get a required-exam hint.</li>
        </ul>
    </section>
}

@code {
    private static readonly (string Shown, string Text)[] Operators =
        [("+", " + "), ("−", " - "), ("×", " * "), ("÷", " / "), ("(", "("), (")", ")"), (",", ", ")];

    private List<FormulaView>? _formulas;
    private string? _platformLab;
    private FormulaForm? _form;
    private Guid? _editingId;
    private bool _kindLocked, _busy;
    private FormulaParseResult? _parse;
    private double? _sCc1 = 12, _sCc2 = 14, _sLab = 15, _sExam = 13;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _formulas = await FormulaSvc.ListAsync();
        _platformLab = await FormulaSvc.GetPlatformLabFormulaAsync();
    }

    private void StartNew(bool lab)
    {
        _editingId = null;
        _kindLocked = false;
        _form = new FormulaForm
        {
            ForLabExam = lab,
            Expression = lab ? (_platformLab ?? "") : GradeCalculator.DefaultNoLabFormula,
            IsDefault = !(_formulas ?? []).Any(f => f.Formula.ForLabExam == lab),
        };
        Reparse();
    }

    private void StartEdit(FormulaView fv)
    {
        var f = fv.Formula;
        _editingId = f.Id;
        _kindLocked = fv.ModulesUsing > 0;
        _form = new FormulaForm { Name = f.Name, Expression = f.Expression, ForLabExam = f.ForLabExam, IsDefault = f.IsDefault };
        Reparse();
    }

    private void Cancel()
    {
        _form = null;
        _editingId = null;
        _parse = null;
    }

    private void SetKind(bool lab)
    {
        if (_form is null) return;
        _form.ForLabExam = lab;
        Reparse();
    }

    private void Reparse() => _parse = _form is null ? null : Formula.Parse(_form.Expression, _form.ForLabExam);

    private async Task Insert(string text)
    {
        if (_form is null) return;
        _form.Expression = await JS.InvokeAsync<string>("gradly.insertAtCursor", "expr", text);
        Reparse();
    }

    private ModuleInput SampleInput(bool withExam) => new(_sCc1, _sCc2, _form!.ForLabExam ? _sLab : null,
        withExam ? _sExam : null, _form.ForLabExam, 20, 10);

    private ModuleResult? PreviewFull => _form is null || _parse is not { Success: true } ? null
        : GradeCalculator.Calculate(SampleInput(true), _form.Expression);

    private ModuleResult? PreviewRequired => _form is null || _parse is not { Success: true } ? null
        : GradeCalculator.Calculate(SampleInput(false), _form.Expression);

    private async Task SaveAsync()
    {
        if (_form is null) return;
        _busy = true;
        try
        {
            await FormulaSvc.SaveAsync(_editingId, _form);
            Toasts.Success(_editingId is null ? "Formula created." : "Formula saved.");
            Cancel();
            await LoadAsync();
        }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task MakeDefault(GradeFormula f)
    {
        try { await FormulaSvc.SetDefaultAsync(f.Id); Toasts.Success($"“{f.Name}” is now your default."); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }

    private async Task Delete(FormulaView fv)
    {
        if (fv.ModulesUsing > 0)
        {
            Toasts.Error($"“{fv.Formula.Name}” is used by {fv.ModulesUsing} module{(fv.ModulesUsing == 1 ? "" : "s")}. Reassign them to another formula before deleting it.");
            return;
        }
        if (!await Confirm.ConfirmAsync($"Delete “{fv.Formula.Name}”?", "This formula will be permanently deleted.", "Delete formula")) return;
        try { await FormulaSvc.DeleteAsync(fv.Formula.Id); Toasts.Success("Formula deleted"); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }

    private async Task AddPlatformLab()
    {
        try { await FormulaSvc.AddPlatformLabFormulaAsync(); Toasts.Success("Lab formula added"); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }
}
