@page "/settings"
@inject AccountService Account
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Account Settings · Gradly</PageTitle>

<div class="page-head">
    <div>
        <h1>Account settings</h1>
        <p class="muted">Your sign-in details</p>
    </div>
</div>

@if (_info is null)
{
    <Loading />
}
else
{
    <div class="settings-grid">
        <section class="card">
            <h2>Account</h2>
            <dl class="facts facts-stack">
                <div><dt>Username</dt><dd>@_info.UserName</dd></div>
                <div><dt>Email</dt><dd>@_info.Email @if (_info.EmailConfirmed) { <span class="tag tag-success">Verified</span> } else { <span class="tag tag-warn">Not verified</span> }</dd></div>
                <div><dt>Member since</dt><dd>@UiFormat.Date(_info.CreatedAtUtc)</dd></div>
                <div><dt>Role</dt><dd>@(_info.IsAdmin ? "Administrator" : "Student")</dd></div>
            </dl>
            <form method="post" action="/account/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-ghost"><Icon Name="logout" Size="16" />Sign out</button>
            </form>
        </section>

        <section class="card">
            <h2>Username</h2>
            <EditForm Model="_username" OnValidSubmit="SaveUserName" FormName="username" class="form">
                <div class="field">
                    <label for="new-username">New username</label>
                    <InputText id="new-username" class="input" @bind-Value="_username.Value" autocomplete="username" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_busy">Change username</button>
            </EditForm>
        </section>

        <section class="card">
            <h2>Email address</h2>
            <p class="muted small">We'll send a confirmation link to the new address. Your email only changes after you open it.</p>
            <EditForm Model="_email" OnValidSubmit="RequestEmailChange" FormName="email" class="form">
                <div class="field">
                    <label for="new-email">New email address</label>
                    <InputText id="new-email" type="email" class="input" @bind-Value="_email.Value" autocomplete="email" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_busy">Send confirmation</button>
            </EditForm>
            @if (_manualLink is not null)
            {
                <div class="callout callout-info">
                    <strong>Email delivery isn't configured on this server.</strong>
                    Open this link to confirm the new address:
                    <div class="link-box"><a href="@_manualLink">@_manualLink</a></div>
                </div>
            }
        </section>

        <section class="card">
            <h2>Password</h2>
            <EditForm Model="_password" OnValidSubmit="ChangePassword" FormName="password" class="form">
                <div class="field">
                    <label for="cur-pw">Current password</label>
                    <InputText id="cur-pw" type="password" class="input" @bind-Value="_password.Current" autocomplete="current-password" />
                </div>
                <div class="field">
                    <label for="new-pw">New password</label>
                    <InputText id="new-pw" type="password" class="input" @bind-Value="_password.Next" autocomplete="new-password" />
                    <span class="hint">At least 10 characters, including a digit and a lowercase letter.</span>
                </div>
                <div class="field">
                    <label for="rep-pw">Repeat new password</label>
                    <InputText id="rep-pw" type="password" class="input" @bind-Value="_password.Repeat" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_busy">Change password</button>
                <p class="muted small">You'll be signed out of all devices and asked to sign in again.</p>
            </EditForm>
        </section>
    </div>
}

@code {
    private AccountInfo? _info;
    private bool _busy;
    private string? _manualLink;
    private readonly StringBox _username = new(), _email = new();
    private readonly PasswordBox _password = new();

    [SupplyParameterFromQuery] private string? Notice { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _info = await Account.GetAsync();
        _username.Value = _info.UserName;
        if (Notice == "username") Toasts.Success("Username updated");
    }

    private async Task SaveUserName()
    {
        await RunAsync(async () =>
        {
            await Account.ChangeUserNameAsync(_username.Value);
            // Re-issue the cookie so the new name shows up, then come back.
            Nav.NavigateTo("/account/refresh?returnUrl=" + Uri.EscapeDataString("/settings?notice=username"), forceLoad: true);
        });
    }

    private async Task RequestEmailChange()
    {
        await RunAsync(async () =>
        {
            var result = await Account.RequestEmailChangeAsync(_email.Value);
            _manualLink = result.ManualLink;
            if (result.EmailSent) Toasts.Success("Check your inbox — we sent a confirmation link to the new address");
            else Toasts.Info("Email delivery isn't configured, so the link is shown below");
            _email.Value = "";
        });
    }

    private async Task ChangePassword()
    {
        if (_password.Next != _password.Repeat)
        {
            Toasts.Error("The new passwords don't match");
            return;
        }
        await RunAsync(async () =>
        {
            await Account.ChangePasswordAsync(_password.Current, _password.Next);
            Nav.NavigateTo("/account/login?notice=password-changed", forceLoad: true);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private sealed class StringBox { public string? Value { get; set; } }

    private sealed class PasswordBox
    {
        public string? Current { get; set; }
        public string? Next { get; set; }
        public string? Repeat { get; set; }
    }
}
