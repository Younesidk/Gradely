@page "/semesters/{Id:guid}"
@inject AcademicService Academic
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>@(_view?.Semester.Name ?? "Semester") · Gradly</PageTitle>

@if (_notFound)
{
    <EmptyState Icon="search" Title="Semester not found" Text="It may have been deleted.">
        <a class="btn btn-primary" href="/semesters">Back to semesters</a>
    </EmptyState>
}
else if (_view is null)
{
    <Loading />
}
else
{
    <a class="back-link" href="/semesters"><Icon Name="back" Size="16" />All semesters</a>
    <div class="page-head">
        <div>
            <h1>@_view.Semester.Name</h1>
            <p class="muted">@Subtitle</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-ghost" @onclick="() => _editSemester = true"><Icon Name="edit" Size="16" />Edit semester</button>
            <button type="button" class="btn btn-primary" @onclick="() => _moduleDialog = new ModuleDialogState()"><Icon Name="plus" Size="16" />Add module</button>
        </div>
    </div>

    <SummaryStats Summary="_view.Summary" />

    @if (_view.Modules.Count == 0)
    {
        <EmptyState Icon="modules" Title="No modules in this semester" Text="Add the modules you're taking, then enter your grades as you receive them.">
            <button type="button" class="btn btn-primary" @onclick="() => _moduleDialog = new ModuleDialogState()"><Icon Name="plus" Size="16" />Add your first module</button>
        </EmptyState>
    }
    else
    {
        <ModulesTable Modules="_view.Modules" Formulas="_formulas" Revision="_revision"
                      OnGrades="SaveGradesAsync" OnFormula="SetFormulaAsync" OnInvalidInput="Toasts.Error"
                      OnEdit="m => _moduleDialog = new ModuleDialogState(m)" OnDelete="DeleteModuleAsync"
                      OnMove="MoveModuleAsync" />
        <p class="muted small table-hint">Grades save automatically when you leave a field. Leave a field empty for “not entered yet” — an empty field is never counted as zero.</p>
    }
}

@if (_editSemester && _view is not null)
{
    <SemesterDialog Existing="_view.Semester" OnClose="() => _editSemester = false" OnSaved="SemesterSaved" />
}
@if (_moduleDialog is not null)
{
    <ModuleDialog SemesterId="Id" Existing="_moduleDialog.Module" Formulas="_formulas"
                  OnClose="() => _moduleDialog = null" OnSaved="ModuleSaved" />
}

@code {
    private sealed record ModuleDialogState(Module? Module = null);

    private SemesterView? _view;
    private IReadOnlyList<GradeFormula> _formulas = [];
    private bool _notFound, _editSemester;
    private ModuleDialogState? _moduleDialog;
    private int _revision;

    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "add")] private string? AddFlag { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        if (AddFlag == "1" && _view is not null && _moduleDialog is null)
        {
            _moduleDialog = new ModuleDialogState();
        }
    }

    private string Subtitle
    {
        get
        {
            var s = _view!.Semester;
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(s.AcademicYear)) parts.Add(s.AcademicYear!);
            if (s.StartDate is { } a) parts.Add(s.EndDate is { } b ? $"{UiFormat.Date(a)} – {UiFormat.Date(b)}" : $"from {UiFormat.Date(a)}");
            else if (s.EndDate is { } c) parts.Add($"until {UiFormat.Date(c)}");
            return parts.Count == 0 ? "Click a module's arrow for details and the exam grade you need." : string.Join(" · ", parts);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _view = await Academic.GetSemesterAsync(Id);
            _formulas = await Academic.GetFormulasAsync();
            _notFound = false;
        }
        catch (NotFoundException)
        {
            _notFound = true;
            _view = null;
        }
    }

    private async Task SaveGradesAsync((Guid ModuleId, GradesForm Grades) e)
    {
        try { await Academic.UpdateGradesAsync(e.ModuleId, e.Grades); }
        catch (UserFacingException ex)
        {
            Toasts.Error(ex.Message);
            _revision++; // re-create the inputs so rejected text doesn't linger
        }
        await LoadAsync();
    }

    private async Task SetFormulaAsync((Guid ModuleId, Guid? FormulaId) e)
    {
        try { await Academic.SetModuleFormulaAsync(e.ModuleId, e.FormulaId); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }

    private async Task MoveModuleAsync((Guid ModuleId, int Direction) e)
    {
        try { await Academic.MoveModuleAsync(e.ModuleId, e.Direction); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }

    private async Task DeleteModuleAsync(Module m)
    {
        var ok = await Confirm.ConfirmAsync($"Delete “{m.Name}”?", "The module and all of its grades will be permanently deleted.", "Delete module");
        if (!ok) return;
        try
        {
            await Academic.DeleteModuleAsync(m.Id);
            Toasts.Success("Module deleted");
        }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }

    private async Task SemesterSaved(Guid _)
    {
        _editSemester = false;
        await LoadAsync();
    }

    private async Task ModuleSaved()
    {
        _moduleDialog = null;
        await LoadAsync();
    }
}
