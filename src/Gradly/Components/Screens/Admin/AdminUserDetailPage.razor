@page "/admin/users/{UserId}"
@inject AdminService Admin
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>@(_detail?.Row.UserName ?? "User") · Gradly</PageTitle>

@if (_notFound)
{
    <EmptyState Icon="🔎" Title="User not found"><a class="btn btn-primary" href="/admin/users">Back to users</a></EmptyState>
}
else if (_detail is null)
{
    <Loading />
}
else
{
    var u = _detail.Row;
    <a class="back-link" href="/admin/users">← All users</a>
    <AdminBanner UserName="@u.UserName" />

    <div class="page-head">
        <div>
            <h1>@u.UserName</h1>
            <p class="muted">@u.Email</p>
        </div>
        <div class="page-actions">
            @if (!u.IsAdmin)
            {
                @if (u.IsDisabled)
                {
                    <button type="button" class="btn btn-primary" @onclick="Toggle">Re-enable account</button>
                }
                else
                {
                    <button type="button" class="btn btn-danger" @onclick="Toggle">Disable account</button>
                }
            }
        </div>
    </div>

    <section class="card">
        <dl class="facts">
            <div><dt>Status</dt><dd>@if (u.IsDisabled) { <span class="badge badge-danger">Disabled</span> } else { <span class="badge badge-success">Active</span> } @if (u.IsAdmin) { <span class="tag tag-primary">Administrator</span> }</dd></div>
            <div><dt>Registered</dt><dd>@UiFormat.Date(u.CreatedAtUtc)</dd></div>
            <div><dt>Last sign-in</dt><dd>@UiFormat.Date(_detail.LastLoginAtUtc)</dd></div>
            @if (u.IsDisabled) { <div><dt>Disabled on</dt><dd>@UiFormat.Date(_detail.DisabledAtUtc)</dd></div> }
            <div><dt>Semesters / modules</dt><dd>@u.Semesters / @u.Modules</dd></div>
            <div><dt>Formulas</dt><dd>@_detail.Formulas</dd></div>
            <div><dt>Approx. storage</dt><dd>≈ @UiFormat.Bytes(u.StorageBytes) <span class="muted small">(estimate)</span></dd></div>
            <div><dt>Pending invitation for this email</dt><dd>@(_detail.PendingInvitationsForEmail > 0 ? "Yes" : "No")</dd></div>
        </dl>
    </section>

    <div class="section-title"><h2>Academic records</h2></div>
    @if (_detail.Semesters.Count == 0)
    {
        <EmptyState Icon="📚" Title="No semesters" Text="This user hasn't created any semesters yet." />
    }
    else
    {
        <div class="card-grid">
            @foreach (var s in _detail.Semesters)
            {
                <SemesterCard View="s" Href="@($"/admin/users/{u.Id}/semesters/{s.Semester.Id}")" />
            }
        </div>
    }
}

@code {
    private AdminUserDetail? _detail;
    private bool _notFound;

    [Parameter] public string UserId { get; set; } = "";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { _detail = await Admin.GetUserAsync(UserId); _notFound = false; }
        catch (NotFoundException) { _notFound = true; _detail = null; }
    }

    private async Task Toggle()
    {
        var u = _detail!.Row;
        var disabling = !u.IsDisabled;
        if (disabling && !await Confirm.ConfirmAsync($"Disable {u.UserName}?",
                "They will be signed out and unable to sign in. Their data is kept.", "Disable account")) return;
        try
        {
            await Admin.SetDisabledAsync(u.Id, disabling);
            Toasts.Success(disabling ? "Account disabled." : "Account re-enabled.");
        }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }
}
