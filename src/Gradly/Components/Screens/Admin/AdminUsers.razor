@page "/admin/users"
@inject AdminService Admin
@inject ToastService Toasts
@inject ConfirmService Confirm

<PageTitle>Users · Gradly</PageTitle>

<div class="page-head">
    <div>
        <h1>Users</h1>
        <p class="muted">All registered accounts, with estimated storage</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/admin/invitations"><Icon Name="mail" Size="16" />Invite someone</a>
    </div>
</div>

<div class="toolbar">
    <input class="input search" type="search" placeholder="Search by username or email…" aria-label="Search users"
           value="@_search" @oninput="OnSearch" />
</div>

@if (_page is null)
{
    <Loading />
}
else if (_page.Items.Count == 0)
{
    <EmptyState Icon="users" Title="No users found" Text="@(string.IsNullOrWhiteSpace(_search) ? "Invite someone to get started." : "Try a different search.")" />
}
else
{
    <div class="table-wrap">
        <table class="table users-table">
            <thead>
                <tr>
                    <th scope="col">Username</th>
                    <th scope="col">Email</th>
                    <th scope="col">Registered</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="num">Semesters</th>
                    <th scope="col" class="num">Modules</th>
                    <th scope="col" class="num">Storage ≈</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _page.Items)
                {
                    <tr @key="u.Id">
                        <td data-label="Username"><a href="/admin/users/@u.Id"><strong>@u.UserName</strong></a> @if (u.IsAdmin) { <span class="tag tag-primary">Admin</span> }</td>
                        <td data-label="Email">@u.Email</td>
                        <td data-label="Registered">@UiFormat.Date(u.CreatedAtUtc)</td>
                        <td data-label="Status">@if (u.IsDisabled) { <span class="badge badge-danger">Disabled</span> } else { <span class="badge badge-success">Active</span> }</td>
                        <td data-label="Semesters" class="num">@u.Semesters</td>
                        <td data-label="Modules" class="num">@u.Modules</td>
                        <td data-label="Storage ≈" class="num">@UiFormat.Bytes(u.StorageBytes)</td>
                        <td class="row-actions">
                            <a class="btn btn-ghost btn-sm" href="/admin/users/@u.Id"><Icon Name="eye" Size="15" />View</a>
                            @if (!u.IsAdmin)
                            {
                                @if (u.IsDisabled)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => Toggle(u)">Re-enable</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-ghost btn-sm text-danger" @onclick="() => Toggle(u)">Disable</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pager">
        <span class="muted small">@_page.Total user@(_page.Total == 1 ? "" : "s") · page @_page.PageNumber of @_page.TotalPages</span>
        <div>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page.PageNumber <= 1)" @onclick="() => GoTo(_page.PageNumber - 1)">Previous</button>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(_page.PageNumber >= _page.TotalPages)" @onclick="() => GoTo(_page.PageNumber + 1)">Next</button>
        </div>
    </div>
}

@code {
    private Page<AdminUserRow>? _page;
    private string _search = "";
    private int _pageNumber = 1;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _page = await Admin.GetUsersAsync(_search, _pageNumber);

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _debounce.Token);
            _pageNumber = 1;
            await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private async Task GoTo(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private async Task Toggle(AdminUserRow u)
    {
        var disabling = !u.IsDisabled;
        if (disabling && !await Confirm.ConfirmAsync($"Disable {u.UserName}?",
                "They will be signed out and unable to sign in. Their data is kept and everything comes back if you re-enable the account.",
                "Disable account")) return;
        try
        {
            await Admin.SetDisabledAsync(u.Id, disabling);
            Toasts.Success(disabling ? $"{u.UserName} was disabled." : $"{u.UserName} was re-enabled.");
        }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        await LoadAsync();
    }
}
