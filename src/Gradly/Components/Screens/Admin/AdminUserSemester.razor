@page "/admin/users/{UserId}/semesters/{SemesterId:guid}"
@inject AdminService Admin

<PageTitle>@(_data?.Semester.Semester.Name ?? "Semester") · Gradly</PageTitle>

@if (_notFound)
{
    <EmptyState Icon="🔎" Title="Not found"><a class="btn btn-primary" href="/admin/users">Back to users</a></EmptyState>
}
else if (_data is null)
{
    <Loading />
}
else
{
    var view = _data.Value.Semester;
    <a class="back-link" href="/admin/users/@UserId">← @_data.Value.User.UserName</a>
    <AdminBanner UserName="@_data.Value.User.UserName" />

    <div class="page-head">
        <div>
            <h1>@view.Semester.Name</h1>
            <p class="muted">@(string.IsNullOrWhiteSpace(view.Semester.AcademicYear) ? "Read-only view" : view.Semester.AcademicYear + " · read-only view")</p>
        </div>
    </div>

    <SummaryStats Summary="view.Summary" />

    @if (view.Modules.Count == 0)
    {
        <EmptyState Icon="🧩" Title="No modules in this semester" />
    }
    else
    {
        <ModulesTable Modules="view.Modules" ReadOnly="true" />
    }
}

@code {
    private (AdminUserRow User, SemesterView Semester)? _data;
    private bool _notFound;

    [Parameter] public string UserId { get; set; } = "";
    [Parameter] public Guid SemesterId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try { _data = await Admin.GetUserSemesterAsync(UserId, SemesterId); _notFound = false; }
        catch (NotFoundException) { _notFound = true; _data = null; }
    }
}
