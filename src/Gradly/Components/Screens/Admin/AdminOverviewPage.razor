@page "/admin"
@inject AdminService Admin
@inject ToastService Toasts

<PageTitle>Administration · Gradly</PageTitle>

<div class="page-head">
    <div>
        <h1>Administration</h1>
        <p class="muted">Platform overview, storage estimates and defaults.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost" href="/admin/users"><Icon Name="users" Size="16" />Users</a>
        <a class="btn btn-primary" href="/admin/invitations"><Icon Name="mail" Size="16" />Invite someone</a>
    </div>
</div>

@if (_data is null)
{
    <Loading />
}
else
{
    <div class="stat-grid">
        <div class="stat"><div class="stat-label">Users</div><div class="stat-value">@_data.Users</div></div>
        <div class="stat stat-success"><div class="stat-label">Active</div><div class="stat-value">@_data.ActiveUsers</div></div>
        <div class="stat stat-danger"><div class="stat-label">Disabled</div><div class="stat-value">@_data.DisabledUsers</div></div>
        <div class="stat stat-warn"><div class="stat-label">Pending invitations</div><div class="stat-value">@_data.PendingInvitations</div></div>
        <div class="stat"><div class="stat-label">Semesters</div><div class="stat-value">@_data.Semesters</div></div>
        <div class="stat"><div class="stat-label">Modules</div><div class="stat-value">@_data.Modules</div></div>
    </div>

    <section class="card">
        <div class="card-head">
            <div>
                <h2>Storage (estimate)</h2>
                <p class="muted small">
                    SQLite keeps all data in one file, so exact per-user disk usage can't be measured.
                    These figures are <strong>approximate logical sizes</strong> of each user's own records
                    (account, semesters, modules, formulas). Calculated @UiFormat.Stamp(_data.Storage.CalculatedAtUtc), cached for a few minutes.
                </p>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="RefreshStorage" disabled="@_busy">Recalculate</button>
        </div>
        <div class="stat-grid stat-grid-compact">
            <div class="stat"><div class="stat-label">Estimated user data</div><div class="stat-value">@UiFormat.Bytes(_data.Storage.TotalEstimatedBytes)</div></div>
            <div class="stat"><div class="stat-label">Database file</div><div class="stat-value">@UiFormat.Bytes(_data.Storage.DatabaseFileBytes)</div><div class="stat-note">+ WAL @UiFormat.Bytes(_data.Storage.WalFileBytes)</div></div>
        </div>
        <h3 class="subhead">Largest consumers</h3>
        @if (_data.LargestUsers.Count == 0)
        {
            <p class="muted">No data yet.</p>
        }
        else
        {
            var max = Math.Max(1, _data.LargestUsers.Max(u => u.StorageBytes));
            <ul class="bar-list">
                @foreach (var u in _data.LargestUsers)
                {
                    <li>
                        <a href="/admin/users/@u.Id" class="bar-name">@u.UserName</a>
                        <div class="bar" role="img" aria-label="@UiFormat.Bytes(u.StorageBytes)"><div class="bar-fill" style="width:@((int)Math.Max(2, 100.0 * u.StorageBytes / max))%"></div></div>
                        <span class="bar-value">≈ @UiFormat.Bytes(u.StorageBytes)</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card">
        <h2>Default lab formula</h2>
        <p class="muted small">
            Applied to <strong>new</strong> accounts as their starter formula for modules with a lab exam.
            Gradly doesn't assume a lab weighting: leave this empty to make each student define their own.
            Existing users can add it from Formula Settings.
        </p>
        <EditForm Model="_lab" OnValidSubmit="SaveLab" FormName="lab" class="form">
            <div class="field">
                <label for="lab-formula">Expression</label>
                <InputText id="lab-formula" class="input mono" @bind-Value="_lab.Value" placeholder="e.g. (CC1 + CC2) / 2 * 0.2 + Lab * 0.2 + Exam * 0.6" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_busy">Save default</button>
        </EditForm>
    </section>
}

@code {
    private AdminOverview? _data;
    private bool _busy;
    private readonly LabBox _lab = new();

    protected override async Task OnInitializedAsync() => await LoadAsync(false);

    private async Task LoadAsync(bool refresh)
    {
        _data = await Admin.GetOverviewAsync(refresh);
        _lab.Value = _data.DefaultLabFormula;
    }

    private async Task RefreshStorage()
    {
        _busy = true;
        try { await LoadAsync(true); Toasts.Success("Storage estimates recalculated."); }
        finally { _busy = false; }
    }

    private async Task SaveLab()
    {
        _busy = true;
        try
        {
            await Admin.SetDefaultLabFormulaAsync(_lab.Value);
            Toasts.Success(string.IsNullOrWhiteSpace(_lab.Value) ? "Default lab formula cleared." : "Default lab formula saved.");
            await LoadAsync(false);
        }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private sealed class LabBox { public string? Value { get; set; } }
}
