@page "/"
@inject AcademicService Academic
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Dashboard · Gradly</PageTitle>

@if (_data is null)
{
    <Loading Text="Loading your dashboard…" />
}
else
{
    <div class="page-head">
        <div>
            <h1>Dashboard</h1>
            <p class="muted">@(_data.Semesters.Count == 0 ? "No semesters yet" : $"{UiFormat.Plural(_data.Semesters.Count, "semester")} · {UiFormat.Plural(_data.Overall.ModuleCount, "module")}")</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-primary" @onclick="() => _showNew = true"><Icon Name="plus" Size="16" />New semester</button>
        </div>
    </div>

    @if (_data.Semesters.Count == 0)
    {
        <section class="card onboarding">
            <h2>Get started in three steps</h2>
            <ol class="steps">
                <li><span class="step-num">1</span><div><strong>Create a semester</strong><p class="muted">For example “S5” or “Spring 2027”. Add as many as you need.</p></div></li>
                <li><span class="step-num">2</span><div><strong>Add your modules</strong><p class="muted">Give each a coefficient. Passing threshold and maximum grade are adjustable.</p></div></li>
                <li><span class="step-num">3</span><div><strong>Enter your grades</strong><p class="muted">CC1, CC2, lab and exam. Gradly tells you the exam grade you need to pass.</p></div></li>
            </ol>
            <div class="onboarding-actions">
                <button type="button" class="btn btn-primary" @onclick="() => _showNew = true"><Icon Name="plus" Size="16" />Create your first semester</button>
                <a class="btn btn-ghost" href="/formulas">Review grading formulas</a>
            </div>
        </section>
    }
    else
    {
        <SummaryStats Summary="_data.Overall" AverageLabel="Overall average" />

        @if (_data.Current is { } cur)
        {
            <section class="card current">
                <div class="card-head">
                    <div>
                        <div class="eyebrow">Current semester</div>
                        <h2><a href="/semesters/@cur.Semester.Id">@cur.Semester.Name</a></h2>
                    </div>
                    <div class="card-head-actions">
                        <a class="btn btn-ghost btn-sm" href="/semesters/@cur.Semester.Id">Open</a>
                        <a class="btn btn-primary btn-sm" href="/semesters/@cur.Semester.Id?add=1"><Icon Name="plus" Size="15" />Add module</a>
                    </div>
                </div>
                @if (cur.Modules.Count == 0)
                {
                    <p class="muted">No modules yet. Add one to start tracking grades.</p>
                }
                else
                {
                    <ul class="mini-list">
                        @foreach (var m in cur.Modules.Take(8))
                        {
                            <li>
                                <span class="mini-name">@m.Module.Name</span>
                                @if (m.Result.Grade is { } g)
                                {
                                    <PassLine Value="g" Max="m.Module.MaxGrade" Threshold="m.Module.PassingThreshold" Passed="m.Result.Passed" />
                                }
                                <span class="mini-grade">@(m.Result.Grade is { } g2 ? GradeFormat.Fixed2(g2) : "—")</span>
                                <StatusBadge Result="m.Result" />
                            </li>
                        }
                    </ul>
                    @if (cur.Modules.Count > 8) { <p class="muted small">@UiFormat.Plural(cur.Modules.Count - 8, "more module") in this semester</p> }
                }
            </section>
        }

        <div class="section-title"><h2>Your semesters</h2><a href="/semesters" class="link">Manage</a></div>
        <div class="card-grid">
            @foreach (var s in _data.Semesters)
            {
                <SemesterCard View="s" Href="@($"/semesters/{s.Semester.Id}")" />
            }
        </div>
    }
}

@if (_showNew)
{
    <SemesterDialog OnClose="() => _showNew = false" OnSaved="Created" />
}

@code {
    private DashboardData? _data;
    private bool _showNew;

    protected override async Task OnInitializedAsync()
    {
        try { _data = await Academic.GetDashboardAsync(); }
        catch (UserFacingException ex) { Toasts.Error(ex.Message); _data = AcademicReader.BuildDashboard([]); }
    }

    private void Created(Guid id) => Nav.NavigateTo($"/semesters/{id}");
}
