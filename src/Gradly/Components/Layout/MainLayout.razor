@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app-shell @(_menuOpen ? "menu-open" : "")">
    <aside class="sidebar" id="sidebar" aria-label="Sidebar">
        <a class="brand" href="/" aria-label="Gradly home">
            <svg class="brand-mark" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 13h16"/><path d="M12 7v10"/></svg>
            <span class="brand-text">Gradly</span>
        </a>

        <nav class="nav" aria-label="Main navigation">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" />Dashboard</NavLink>
            <NavLink class="nav-link" href="semesters"><Icon Name="semesters" />Semesters</NavLink>
            <NavLink class="nav-link" href="formulas"><Icon Name="formula" />Formula settings</NavLink>
            <NavLink class="nav-link" href="settings"><Icon Name="account" />Account settings</NavLink>

            <AuthorizeView Policy="@Policies.AdminOnly">
                <div class="nav-section">Administration</div>
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All"><Icon Name="shield" />Overview</NavLink>
                <NavLink class="nav-link" href="admin/users"><Icon Name="users" />Users</NavLink>
                <NavLink class="nav-link" href="admin/invitations"><Icon Name="mail" />Invitations</NavLink>
            </AuthorizeView>
        </nav>

        <div class="sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="who" title="@context.User.Identity?.Name">
                        <span class="who-name">@context.User.Identity?.Name</span>
                        <span class="who-role">@(context.User.IsInRole(Roles.Admin) ? "Administrator" : "Student")</span>
                    </div>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-ghost btn-block btn-sm"><Icon Name="logout" Size="16" />Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>
    <div class="scrim" @onclick="CloseMenu"></div>

    <div class="main">
        <header class="topbar">
            <button type="button" class="icon-btn menu-btn" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" @onclick="ToggleMenu">
                <Icon Name="menu" Size="18" />
            </button>
            <a class="topbar-brand" href="/">Gradly</a>
            <div class="spacer"></div>
            <button type="button" class="icon-btn theme-btn" aria-label="Toggle light / dark theme" title="Toggle theme" @onclick="ToggleTheme">
                <span class="theme-sun"><Icon Name="sun" Size="18" /></span>
                <span class="theme-moon"><Icon Name="moon" Size="18" /></span>
            </button>
        </header>

        <main class="content" id="main">
            @Body
        </main>
    </div>
</div>

<ToastHost />
<ConfirmHost />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool _menuOpen;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("gradly.toggleTheme");

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
