# Copy to .env (git-ignored) and load it into your shell, or use scripts/dev.ps1 which sets sensible local defaults.
# The application reads plain environment variables; it does not parse .env files itself.

# --- first-run administrator (created once, then ignored) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase-1
# Optional: starter formula for modules WITH a lab exam (Gradly never assumes a lab weighting)
# DEFAULT_LAB_FORMULA=(CC1 + CC2) / 2 * 0.2 + Lab * 0.2 + Exam * 0.6

# --- general ---
APP_BASE_URL=http://localhost:8080
# GRADLY_ADDR=:8080
# GRADLY_DATA_DIR=./data
# GRADLY_SECURE_COOKIES=true
# GRADLY_AUTH_RATE_LIMIT=10

# --- email (optional; without it invitation links are shown to copy) ---
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=Gradly <no-reply@your-verified-domain.example>
